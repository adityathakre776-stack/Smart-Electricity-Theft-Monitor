    {
        "id": "split_moduleA",
        "type": "function",
        "z": "tab_powertheft",
        "name": "Parse Module A",
        "func": "// Store in flow context for cross-referencing\nflow.set('voltageA', msg.payload.voltage);\nflow.set('currentA', msg.payload.current);\nflow.set('powerA', msg.payload.power);\n\nvar msgs = [];\n\n// Voltage gauge\nmsgs[0] = { payload: msg.payload.voltage, topic: 'voltage' };\n// Current A gauge\nmsgs[1] = { payload: msg.payload.current, topic: 'currentA' };\n// Power A text\nmsgs[2] = { payload: msg.payload.power.toFixed(2) + ' W', topic: 'powerA' };\n// Chart data point\nmsgs[3] = { payload: { \"ModuleA Current\": msg.payload.current }, topic: 'chart' };\n\nreturn msgs;",
        "outputs": 4,
        "x": 360,
        "y": 80,
        "wires": [
            [
                "gauge_voltage"
            ],
            [
                "gauge_currentA"
            ],
            [
                "text_powerA"
            ],
            [
                "chart_current"
            ]
        ]
    },
    {
        "id": "split_moduleB",
        "type": "function",
        "z": "tab_powertheft",
        "name": "Parse Module B",
        "func": "flow.set('currentB', msg.payload.current);\nflow.set('powerB', msg.payload.power);\n\nvar msgs = [];\n\n// Current B gauge\nmsgs[0] = { payload: msg.payload.current, topic: 'currentB' };\n// Power B text\nmsgs[1] = { payload: msg.payload.power.toFixed(2) + ' W', topic: 'powerB' };\n// Chart data point\nmsgs[2] = { payload: { \"ModuleB Current\": msg.payload.current }, topic: 'chart' };\n\n// Compute difference locally as backup\nvar cA = flow.get('currentA') || 0;\nvar diff = cA - msg.payload.current;\nmsgs[3] = { payload: diff.toFixed(4) + ' A', topic: 'diff' };\n\nreturn msgs;",
        "outputs": 4,
        "x": 360,
        "y": 160,
        "wires": [
            [
                "gauge_currentB"
            ],
            [
                "text_powerB"
            ],
            [
                "chart_current"
            ],
            [
                "text_diff"
            ]
        ]
    },
    {
        "id": "process_alert",
        "type": "function",
        "z": "tab_powertheft",
        "name": "Process Alert",
        "func": "var isTheft = msg.payload.alert;\nvar diff    = msg.payload.difference;\nvar cnt     = msg.payload.count;\n\nvar msgs = [];\n\n// Alert indicator\nif (isTheft) {\n    msgs[0] = {\n        payload: '⚠ THEFT DETECTED!',\n        style: { background: '#ff2222', color: '#fff', fontSize: '18px', fontWeight: 'bold' },\n        topic: 'alert'\n    };\n} else {\n    msgs[0] = {\n        payload: '✔ NORMAL — No Theft',\n        style: { background: '#22cc44', color: '#fff', fontSize: '16px' },\n        topic: 'alert'\n    };\n}\n\n// Difference text\nmsgs[1] = { payload: diff.toFixed(4) + ' A', topic: 'diff' };\n\n// Alert count\nmsgs[2] = { payload: cnt, topic: 'count' };\n\n// Notification (only on new theft)\nif (isTheft) {\n    msgs[3] = {\n        payload: '🚨 POWER THEFT DETECTED! Difference: ' + diff.toFixed(3) + ' A',\n        topic: 'notification'\n    };\n}\n\nreturn msgs;",
        "outputs": 4,
        "x": 360,
        "y": 240,
        "wires": [
            [
                "ui_alert_text"
            ],
            [
                "text_diff"
            ],
            [
                "text_alert_count"
            ],
            [
                "ui_notification"
            ]
        ]
    },
